# Copy to .env at the repo root and fill in. .env is gitignored.
# Nothing here belongs in web/ — Vite compiles its env into the shipped bundle,
# so anything the client can read is public.

# MongoDB Atlas connection string, including the database name.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/efinance?retryWrites=true&w=majority

# Signs session tokens. Any long random string; rotating it signs everyone out.
# Generate one with: node -p "require('crypto').randomBytes(48).toString('hex')"
AUTH_SECRET=

# Marks the written answer. Server only.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
